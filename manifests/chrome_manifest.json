{
    "manifest_version": 3,
    "name": "AI Chat TOC",
    "version": "1.8.0",
    "description": "Adds a Table of Contents to ChatGPT, Gemini, Perplexity, Claude, and Grok",
    "icons": {
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "toggle-toc": {
            "suggested_key": {
                "default": "Ctrl+Shift+F",
                "mac": "MacCtrl+Shift+F"
            },
            "description": "Toggle Table of Contents"
        },
        "toggle-compact-mode": {
            "suggested_key": {
                "default": "Alt+Shift+C",
                "mac": "Alt+Shift+C"
            },
            "description": "Toggle Compact Navigation Mode"
        }
    },
    "action": {
        "default_popup": "popup.html"
    },
    "host_permissions": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://www.perplexity.ai/*",
        "*://claude.ai/*",
        "*://grok.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://chatgpt.com/*",
                "*://gemini.google.com/*",
                "*://www.perplexity.ai/*",
                "*://claude.ai/*",
                "*://grok.com/*"
            ],
            "js": [
                "themes.js",
                "ui.js",
                "main.js"
            ],
            "css": [
                "style.css"
            ],
            "run_at": "document_idle"
        }
    ]
}